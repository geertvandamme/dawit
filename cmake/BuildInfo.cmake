# Writes BuildInfo.h: the version and what git knows about this checkout. Run at every build with
# -DSOURCE_DIR -DOUT_FILE -DDAWIT_VERSION -DDAWIT_SOURCE_URL. The file is only rewritten when its content changes,
# so an unchanged tree recompiles nothing. Without git (or outside a git checkout) the commit stays empty and the
# About window says "commit unknown".
set(commit "")
set(dirty 0)
set(exact_tag 0)

find_program(GIT_EXE git)

if(GIT_EXE)
    execute_process(COMMAND ${GIT_EXE} rev-parse --show-toplevel WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE top RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

    if(rc EQUAL 0)
        get_filename_component(top "${top}" REALPATH)
        get_filename_component(src "${SOURCE_DIR}" REALPATH)
    endif()

    # An archive unpacked inside some other repository is not a checkout of DawIt.
    if(rc EQUAL 0 AND top STREQUAL src)
        execute_process(COMMAND ${GIT_EXE} rev-parse HEAD WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE commit RESULT_VARIABLE rc2 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

        if(NOT rc2 EQUAL 0)
            set(commit "")
        else()
            execute_process(COMMAND ${GIT_EXE} status --porcelain --untracked-files=no WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE changes ERROR_QUIET)

            if(NOT changes STREQUAL "")
                set(dirty 1)
            endif()

            execute_process(COMMAND ${GIT_EXE} describe --exact-match --tags HEAD WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE tag RESULT_VARIABLE rc3 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)

            if(rc3 EQUAL 0 AND tag STREQUAL "v${DAWIT_VERSION}")
                set(exact_tag 1)
            endif()
        endif()
    endif()
endif()

string(REPLACE "\\" "\\\\" url "${DAWIT_SOURCE_URL}")
string(REPLACE "\"" "\\\"" url "${url}")

set(content "// Generated by cmake/BuildInfo.cmake at every build. Do not edit.
#pragma once

namespace daw::buildinfo
{
    constexpr const char* version = \"${DAWIT_VERSION}\";
    constexpr const char* commit = \"${commit}\";            // full hash; empty without git
    constexpr bool hasLocalChanges = ${dirty};
    constexpr bool isExactTag = ${exact_tag};                // HEAD is exactly the tag v<version>
    constexpr const char* sourceUrlOverride = \"${url}\";    // DAWIT_SOURCE_URL
}
")
string(REPLACE "constexpr bool hasLocalChanges = 1" "constexpr bool hasLocalChanges = true" content "${content}")
string(REPLACE "constexpr bool hasLocalChanges = 0" "constexpr bool hasLocalChanges = false" content "${content}")
string(REPLACE "constexpr bool isExactTag = 1" "constexpr bool isExactTag = true" content "${content}")
string(REPLACE "constexpr bool isExactTag = 0" "constexpr bool isExactTag = false" content "${content}")

set(old "")
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" old)
endif()

if(NOT old STREQUAL content)
    get_filename_component(dir "${OUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${OUT_FILE}" "${content}")
endif()
